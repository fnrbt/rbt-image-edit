; Variant of adjust.imed with a few edits, to demonstrate the AST diff (what a chat turn shows):
;   - saturate amount 1.2 → 1.6
;   - levels gamma 0.6 → 0.95
;   - an extra text layer appended
(image (1600 1000) :bg #000000 :out "out/adjust-v2.png"

  (sources (ramp "assets/ramp.png"))

  (canvas
    (stack
      (-> (raster ramp)
          (curves :points (0 0 64 28 192 228 255 255))
          (saturate :amount 1.6))

      (adjust-below levels :black 40 :white 220 :gamma 0.95 :region (rect 0 0 800 1000))

      (adjust-below posterize :levels 6 :region (rect 0 470 1600 130))

      (text "NON-DESTRUCTIVE" :size 92 :fill #ffffff :x 90 :y 130)
      (text "left half: levels+gamma   band: posterize   whole: curves + saturate"
            :size 32 :fill #ffffff :x 92 :y 940)
      (text "+ added in v2" :size 40 :fill #ffcc33 :x 92 :y 990))))
